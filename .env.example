PORT=4000

# Postgres connection string (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_tracker
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_tracker_test

# Set to "true" to log SQL queries
DB_LOGGING=false

# Secret for signing login JWTs (required, 32+ characters).
# Generate one with: openssl rand -base64 32
JWT_SECRET=
# How long a login token stays valid, in jose duration format ("15m", "1h", "7d")
JWT_EXPIRES_IN=15m
